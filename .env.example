# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets to this repo (it's public).

# --- MongoDB Atlas ---
# Full connection string including username/password. Generate the DB user's
# password via Atlas's own generator rather than hand-typing one.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app-name>"
MONGODB_DB_NAME="adalajenterprise"

# --- Google OAuth ---
# From Google Cloud Console > APIs & Services > Credentials.
# Client ID is safe to expose client-side (VITE_ prefix); Client Secret is
# NOT currently used by the ID-token verification flow in auth.server.ts,
# but is reserved here in case the flow changes to authorization-code
# exchange later. If ever populated, it must stay server-side only —
# never add a VITE_GOOGLE_CLIENT_SECRET.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# --- App session signing ---
# Random secret used to sign this app's own session JWTs (replaces Supabase
# Auth's role). Generate with: openssl rand -base64 48
SESSION_JWT_SECRET=""
